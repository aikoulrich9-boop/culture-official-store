# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Projet: PRIORITY / ILLEGAL Streetwear
# ==============================================================================
# IMPORTANT:
# - Ne jamais commiter de vraies clés secrètes dans Git.
# - Renseigner ces variables dans le tableau de bord Vercel (Settings > Environment Variables)
#   ou dans un fichier local .env non versionné pour le développement.
# ==============================================================================

# 1. URL publique Supabase (Accessible côté client et serveur)
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Clé publique Supabase Anon (Accessible côté client, soumise aux règles RLS)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-jwt-token

# 3. Clé secrète de service Supabase (STRICTEMENT RÉSERVÉE AU SERVEUR / VERCEL FUNCTIONS)
# ATTENTION: Cette clé contourne les politiques RLS. Ne JAMAIS l'exposer dans les fichiers HTML/JS clients.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret

# 4. Origines CORS autorisées (Optionnel, défauts configurés dans api/decrement-stock.js)
ALLOWED_ORIGINS=https://priority-illegal.com,https://www.priority-illegal.com,http://localhost:3000

# 5. Paramètres de la boutique
DEFAULT_CURRENCY=FCFA
DEFAULT_COUNTRY=Bénin
DEFAULT_MIN_PAYOUT=10000
WHATSAPP_NUMBER=2290165173634

